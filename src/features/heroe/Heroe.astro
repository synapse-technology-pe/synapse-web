---
// Inicio: "SYN" y "APSE" gigantes en rojo con el logo 3D armándose en el hueco, etiquetas técnicas arriba,
// qué hacemos y para quién abajo, y una cinta de tecnologías al pie.
import Logo from "../../components/ui/Logo.astro";
import Icono from "../../components/ui/Icono.astro";
import { tecnologias } from "../../data/tecnologias";

const cinta = tecnologias.slice(0, 14);
---

<section class="heroe" id="inicio" data-heroe aria-labelledby="heroe-titulo">
  <div class="heroe__brillo" aria-hidden="true"></div>
  <canvas class="heroe__lienzo" data-heroe-lienzo aria-hidden="true"></canvas>

  <div class="contenedor heroe__barra" data-heroe-entra>
    <span class="heroe__mono">© 2026</span>
    <ul class="heroe__lineas heroe__mono">
      <li><b>01.</b> Software a medida</li>
      <li><b>02.</b> Apps y páginas web</li>
      <li><b>03.</b> IA y automatización</li>
    </ul>
    <span class="heroe__mono heroe__estado"><i></i>Lima, Perú · Disponibles</span>
  </div>

  <div class="heroe__escena">
    <p class="heroe__marca" aria-hidden="true" data-heroe-marca data-heroe-entra>
      <span class="heroe__mitad" data-heroe-mitad="izq">Syn</span>
      <span class="heroe__hueco" data-heroe-hueco>
        <span class="heroe__respaldo"><Logo id="heroe-respaldo" variante="marca" titulo="" /></span>
      </span>
      <span class="heroe__mitad" data-heroe-mitad="der">apse</span>
    </p>
  </div>

  <div class="contenedor heroe__contenido" data-heroe-contenido>
    <h1 class="heroe__titulo" id="heroe-titulo" data-heroe-titulo data-heroe-entra>
      Software <span class="acento">a medida</span><br />para tu empresa
    </h1>
    <div class="heroe__lado">
      <p class="heroe__texto" data-heroe-entra>
        Páginas web, tiendas online, sistemas de gestión, apps, plataformas SaaS e inteligencia artificial. Lo
        diseñamos, lo programamos y lo dejamos funcionando.
      </p>
      <div class="heroe__acciones" data-heroe-entra>
        <a class="boton boton--primario" href="#contacto">
          Empezar un proyecto
          <Icono nombre="arrow-right" clase="icono boton__flecha" />
        </a>
        <a class="boton boton--secundario" href="#proyectos">Ver proyectos</a>
      </div>
    </div>
  </div>

  <div class="heroe__pie" data-heroe-entra aria-hidden="true">
    <div class="heroe__cinta">
      {
        [...cinta, ...cinta].map((t) => (
          <span class="heroe__tec">
            <Icono nombre={t.icono} clase="heroe__tec-logo" />
            {t.nombre}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .heroe {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: calc(var(--nav-alto) + 8px);
    overflow: hidden;
    isolation: isolate;
  }
  .heroe__brillo {
    position: absolute;
    z-index: -3;
    left: 50%;
    top: 42%;
    width: min(110vw, 1300px);
    aspect-ratio: 1.6;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(ellipse, color-mix(in srgb, var(--rojo) 26%, transparent) 0%, transparent 62%);
    filter: blur(24px);
  }
  .heroe__mono {
    font-family: var(--fuente-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--texto-2);
  }
  .heroe__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 6px;
  }
  .heroe__lineas {
    display: flex;
    gap: clamp(16px, 4vw, 64px);
    white-space: nowrap;
  }
  .heroe__estado {
    white-space: nowrap;
  }
  @media (max-width: 1180px) {
    .heroe__lineas li:last-child {
      display: none;
    }
  }
  .heroe__lineas b {
    color: var(--rojo-texto);
    font-weight: 600;
  }
  .heroe__estado {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .heroe__estado i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18);
  }

  /* Palabra gigante y logo 3D delante */
  .heroe__escena {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
  }
  /* "SYN" y "APSE" a los lados y el logo 3D en el hueco del medio: no se cruzan */
  .heroe__marca {
    position: relative;
    z-index: -2;
    display: flex;
    align-items: center;
    margin: 0;
    font-family: var(--fuente-titulos);
    font-size: clamp(4.4rem, 21vw, 23rem);
    line-height: 0.82;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    user-select: none;
    white-space: nowrap;
  }
  .heroe__mitad {
    display: block;
    padding-block: 0.04em;
    background: linear-gradient(180deg, #ff3030 0%, #e5121b 45%, #6d0b10 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .heroe__hueco {
    position: relative;
    flex: none;
    width: 0.9em;
    align-self: stretch;
  }
  .heroe__lienzo {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1s var(--ease-suave);
  }
  :global(.heroe--3d) .heroe__lienzo {
    opacity: 1;
  }
  .heroe__respaldo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.74em;
    translate: -50% -50%;
    transition: opacity 0.8s var(--ease-suave);
  }
  .heroe__respaldo :global(.logo) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.6));
  }
  /* Con JavaScript el logo lo arma la escena 3D: el SVG solo se muestra si no hay 3D (o sin JavaScript). */
  :global(html.js) .heroe__respaldo {
    opacity: 0;
  }
  :global(html.js) .heroe--sin3d .heroe__respaldo {
    opacity: 1;
  }

  .heroe__contenido {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: end;
    gap: 24px 56px;
    padding-bottom: 26px;
  }
  .heroe__titulo {
    font-size: clamp(2.6rem, 1rem + 4.4vw, 5.6rem);
    line-height: 0.92;
  }
  .heroe__titulo :global(.heroe__linea-mask) {
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }
  .heroe__texto {
    max-width: 46ch;
    color: var(--texto-2);
    font-size: 1.02rem;
  }
  .heroe__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  /* Cinta de tecnologías */
  .heroe__pie {
    border-top: 1px solid var(--linea);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .heroe__cinta {
    display: flex;
    width: max-content;
    animation: cinta 46s linear infinite;
  }
  .heroe__pie:hover .heroe__cinta {
    animation-play-state: paused;
  }
  .heroe__tec {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 30px calc(16px + env(safe-area-inset-bottom, 0px));
    font-family: var(--fuente-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-3);
    white-space: nowrap;
  }
  .heroe__tec :global(.heroe__tec-logo) {
    width: auto;
    height: 18px;
    max-width: 60px;
    filter: grayscale(1) brightness(1.6) opacity(0.75);
  }
  :global([data-tema="claro"]) .heroe__tec :global(.heroe__tec-logo) {
    filter: grayscale(1) brightness(0.4) opacity(0.75);
  }
  @keyframes cinta {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 899px) {
    .heroe__lineas {
      display: none;
    }
    .heroe__contenido {
      grid-template-columns: 1fr;
    }
    .heroe__marca {
      font-size: 21.5vw;
    }
  }
  @media (max-width: 520px) {
    .heroe__acciones .boton {
      flex: 1 1 100%;
    }
    .heroe__titulo {
      font-size: 2.9rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .heroe__cinta {
      animation: none;
    }
  }
</style>
