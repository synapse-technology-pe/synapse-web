---
// Franja con los servicios en tipografía gigante: una fila va a la izquierda y otra a la derecha al hacer scroll.
const palabras = [
  "Páginas web",
  "Tiendas online",
  "Sistemas de gestión",
  "Apps móviles",
  "SaaS",
  "Inteligencia artificial",
  "Automatización",
  "Integraciones",
];
const repetidas = [...palabras, ...palabras, ...palabras];
---

<section class="franja" aria-label="Lo que desarrollamos">
  <p class="sr-only">{palabras.join(", ")}.</p>
  <div class="franja__fila" data-franja-fila="izquierda" aria-hidden="true">
    <div class="franja__pista">
      {
        repetidas.map((p) => (
          <span class="franja__item">
            {p}
            <i class="franja__hex" />
          </span>
        ))
      }
    </div>
  </div>
  <div class="franja__fila franja__fila--contorno" data-franja-fila="derecha" aria-hidden="true">
    <div class="franja__pista">
      {
        [...repetidas].reverse().map((p) => (
          <span class="franja__item">
            {p}
            <i class="franja__hex" />
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .franja {
    position: relative;
    padding-block: clamp(28px, 4vw, 56px);
    border-block: 1px solid var(--linea);
    background: var(--fondo);
    overflow: hidden;
  }
  .franja__fila {
    display: flex;
    white-space: nowrap;
  }
  .franja__pista {
    display: flex;
    flex: none;
    will-change: transform;
  }
  .franja__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(20px, 3vw, 44px);
    padding-right: clamp(20px, 3vw, 44px);
    font-family: var(--fuente-titulos);
    text-transform: uppercase;
    font-size: clamp(2.6rem, 1.2rem + 6vw, 7.6rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.01em;
  }
  .franja__fila--contorno .franja__item {
    color: transparent;
    -webkit-text-stroke: 1.4px color-mix(in srgb, var(--texto) 45%, transparent);
  }
  .franja__hex {
    width: 0.34em;
    height: 0.38em;
    flex: none;
    background: var(--degradado-rojo);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  }
</style>
