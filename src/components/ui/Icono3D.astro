---
// Ícono con volumen: varias copias del mismo glifo apiladas en profundidad (CSS 3D).
// Al inclinarse la tarjeta, se ve el grosor del ícono como si fuera una pieza extruida.
import Icono from "./Icono.astro";

interface Props {
  nombre: string;
  capas?: number;
}

const { nombre, capas = 7 } = Astro.props;
---

<span class="i3d" aria-hidden="true">
  {
    Array.from({ length: capas }, (_, k) => (
      <span class="i3d__capa" style={`--k:${k}`}>
        <Icono nombre={nombre} />
      </span>
    ))
  }
</span>

<style>
  .i3d {
    position: relative;
    display: block;
    width: 58px;
    height: 58px;
    transform-style: preserve-3d;
  }
  .i3d__capa {
    position: absolute;
    inset: 0;
    transform: translateZ(calc(var(--k) * -1.5px));
    color: color-mix(in srgb, var(--rojo) calc(100% - var(--k) * 11%), #120000);
  }
  .i3d__capa:first-child {
    color: var(--rojo-vivo);
    filter: drop-shadow(0 0 12px rgba(255, 42, 42, 0.45));
  }
  .i3d__capa :global(.icono) {
    width: 100%;
    height: 100%;
  }
</style>
