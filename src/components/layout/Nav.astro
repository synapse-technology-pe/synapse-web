---
// Menú superior fijo, botón de tema y menú a pantalla completa en celulares.
import Logo from "../ui/Logo.astro";
import Icono from "../ui/Icono.astro";
import { navegacion } from "../../data/sitio";
import { proyectos } from "../../data/proyectos";
import { resenasVisibles } from "../../data/resenas";

// Las secciones vacías no salen en la web publicada, así que tampoco su enlace.
const hayTrabajos = import.meta.env.DEV || proyectos.length > 0;
const hayResenas = resenasVisibles.length > 0;
const enlaces = navegacion.filter(
  (e) => (e.href !== "#proyectos" || hayTrabajos) && (e.href !== "#resenas" || hayResenas),
);
---

<header class="nav" data-nav>
  <div class="nav__barra contenedor">
    <a href="#inicio" class="nav__logo" aria-label="Synapse, ir al inicio" data-nav-logo>
      <Logo id="nav" titulo="Synapse" />
    </a>
    <nav class="nav__enlaces" aria-label="Principal">
      <ul>
        {
          enlaces.map((e) => (
            <li>
              <a class="nav__enlace" href={e.href}>
                {e.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="nav__acciones">
      <button class="tema" type="button" data-tema-toggle aria-label="Activar modo claro">
        <span class="tema__icono tema__icono--sol"><Icono nombre="sun" /></span>
        <span class="tema__icono tema__icono--luna"><Icono nombre="moon" /></span>
      </button>
      <a class="boton boton--primario boton--chico nav__cta" href="#contacto">Cotizar proyecto</a>
      <button
        class="nav__hamburguesa"
        type="button"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
        data-menu-boton
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu-movil" id="menu-movil" data-menu hidden>
  <nav class="menu-movil__nav contenedor" aria-label="Menú">
    <ul>
      {
        enlaces.map((e, i) => (
          <li>
            <a class="menu-movil__enlace" href={e.href} data-menu-enlace>
              <span class="menu-movil__num">0{i + 1}</span>
              {e.texto}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="boton boton--primario menu-movil__cta" href="#contacto" data-menu-enlace>
      Cotizar proyecto
      <Icono nombre="arrow-right" clase="icono boton__flecha" />
    </a>
  </nav>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding-top: env(safe-area-inset-top, 0px);
    transition:
      transform 0.5s var(--ease-salida),
      background-color 0.4s var(--ease-suave),
      border-color 0.4s var(--ease-suave);
    border-bottom: 1px solid transparent;
  }
  .nav.nav--solida {
    background: color-mix(in srgb, var(--fondo) 72%, transparent);
    border-bottom-color: var(--linea);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
  }
  /* Equipo lento (src/lib/calidad.ts): sin desenfoque de fondo, que se recalcula en cada cuadro sobre el 3D. */
  :global(html.calidad-baja) .nav.nav--solida {
    background: color-mix(in srgb, var(--fondo) 94%, transparent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .nav.nav--oculta {
    transform: translateY(-110%);
  }
  .nav__barra {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--nav-alto);
  }
  .nav__logo {
    display: block;
    flex: none;
  }
  .nav__logo :global(.logo) {
    height: 34px;
    width: auto;
  }
  .nav__enlaces {
    margin-inline: auto;
  }
  .nav__enlaces ul {
    display: flex;
    gap: 4px;
  }
  .nav__enlace {
    display: block;
    padding: 8px 14px;
    border-radius: var(--radio-pildora);
    color: var(--texto-2);
    font-size: 0.93rem;
    font-weight: 500;
    transition:
      color 0.25s,
      background-color 0.25s;
  }
  .nav__enlace:hover,
  .nav__enlace.activo {
    color: var(--texto);
    background: var(--linea);
  }
  .nav__acciones {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }
  .nav__enlaces + .nav__acciones {
    margin-left: 0;
  }
  .tema {
    position: relative;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--linea-fuerte);
    border-radius: 50%;
    background: transparent;
    color: var(--texto);
    transition:
      border-color 0.25s,
      transform 0.35s var(--ease-salida);
  }
  .tema:hover {
    border-color: var(--texto-2);
    transform: rotate(-12deg);
  }
  .tema:active {
    transform: scale(0.94);
  }
  .tema__icono {
    position: absolute;
    display: grid;
    place-items: center;
    transition:
      transform 0.5s var(--ease-salida),
      opacity 0.3s;
  }
  .tema__icono :global(.icono) {
    width: 19px;
    height: 19px;
  }
  :global([data-tema="oscuro"]) .tema__icono--luna,
  :global([data-tema="claro"]) .tema__icono--sol {
    opacity: 0;
    transform: rotate(90deg) scale(0.4);
  }
  .nav__hamburguesa {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border: 1px solid var(--linea-fuerte);
    border-radius: 50%;
    background: transparent;
  }
  .nav__hamburguesa span {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 2px;
    border-radius: 2px;
    background: var(--texto);
    transition:
      transform 0.45s var(--ease-salida),
      top 0.45s var(--ease-salida);
  }
  .nav__hamburguesa span:first-child {
    top: 17px;
  }
  .nav__hamburguesa span:last-child {
    top: 25px;
  }
  .nav__hamburguesa[aria-expanded="true"] span:first-child {
    top: 21px;
    transform: rotate(45deg);
  }
  .nav__hamburguesa[aria-expanded="true"] span:last-child {
    top: 21px;
    transform: rotate(-45deg);
  }

  .menu-movil {
    position: fixed;
    inset: 0;
    z-index: 95;
    display: flex;
    background: var(--fondo);
    padding-top: calc(var(--nav-alto) + env(safe-area-inset-top, 0px) + 24px);
    padding-bottom: calc(32px + env(safe-area-inset-bottom, 0px));
    clip-path: inset(0 0 100% 0);
  }
  .menu-movil[hidden] {
    display: none;
  }
  .menu-movil__nav {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }
  .menu-movil__nav ul {
    display: grid;
    gap: 4px;
  }
  .menu-movil__enlace {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 8px 0;
    font-family: var(--fuente-titulos);
    text-transform: uppercase;
    font-size: clamp(2rem, 9vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .menu-movil__num {
    font-family: var(--fuente-texto);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--rojo-texto);
  }
  .menu-movil__cta {
    width: 100%;
  }

  @media (max-width: 1080px) {
    .nav__enlaces {
      display: none;
    }
    .nav__hamburguesa {
      display: block;
    }
  }
  @media (max-width: 560px) {
    .nav__cta {
      display: none;
    }
    .nav__logo :global(.logo) {
      height: 30px;
    }
  }
</style>
