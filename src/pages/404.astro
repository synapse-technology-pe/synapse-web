---
import Base from "../layouts/Base.astro";
---

<Base titulo="Página no encontrada | Synapse" descripcion="La página que buscas no existe." conIntro={false} indexar={false}>
  <section class="no-encontrada contenedor">
    <p class="etiqueta">Error 404</p>
    <h1>Esta página no existe</h1>
    <p>Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <a class="boton boton--primario" href="/">Volver al inicio</a>
  </section>
</Base>

<style>
  .no-encontrada {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 22px;
    min-height: 80vh;
    padding-top: var(--nav-alto);
  }
  .no-encontrada h1 {
    font-size: var(--t-h1);
  }
  .no-encontrada p:not(.etiqueta) {
    color: var(--texto-2);
    font-size: var(--t-grande);
  }
</style>
